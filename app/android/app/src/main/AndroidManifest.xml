<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SECURITY: release builds have NO internet permission (it is added only in
      src/debug for Metro). Even if something went wrong, Multi-App cannot send
      data anywhere.
    -->
    <!-- Only apps signed with the Multi-App key may drive the Clone Space. -->
    <permission
        android:name="com.eri.multiapp.permission.CONTROL_SPACE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.eri.multiapp.permission.CONTROL_SPACE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Android 11+ package visibility: see every launchable app so it can be cloned. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="com.eri.multiapp.action.PING" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- ===== Clone Space (work profile) ===== -->

      <receiver
        android:name=".space.MultiAppAdminReceiver"
        android:description="@string/admin_description"
        android:label="@string/app_name"
        android:permission="android.permission.BIND_DEVICE_ADMIN"
        android:exported="true">
        <meta-data
          android:name="android.app.device_admin"
          android:resource="@xml/device_admin" />
        <intent-filter>
          <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
          <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
        </intent-filter>
      </receiver>

      <activity
        android:name=".space.ProvisioningModeActivity"
        android:permission="android.permission.BIND_DEVICE_ADMIN"
        android:theme="@style/Transparent"
        android:exported="true">
        <intent-filter>
          <action android:name="android.app.action.GET_PROVISIONING_MODE" />
          <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
      </activity>

      <activity
        android:name=".space.PolicyComplianceActivity"
        android:permission="android.permission.BIND_DEVICE_ADMIN"
        android:theme="@style/Transparent"
        android:exported="true">
        <intent-filter>
          <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
          <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
      </activity>

      <activity
        android:name=".space.ProvisioningSuccessActivity"
        android:theme="@style/Transparent"
        android:exported="true">
        <intent-filter>
          <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
          <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
      </activity>

      <!-- Disabled in the personal profile; enabled only inside the Space. -->
      <activity
        android:name=".space.ProfileActionActivity"
        android:enabled="false"
        android:permission="com.eri.multiapp.permission.CONTROL_SPACE"
        android:theme="@style/Transparent"
        android:excludeFromRecents="true"
        android:exported="true">
        <intent-filter>
          <action android:name="com.eri.multiapp.action.PING" />
          <action android:name="com.eri.multiapp.action.CLONE" />
          <action android:name="com.eri.multiapp.action.REMOVE" />
          <action android:name="com.eri.multiapp.action.FREEZE" />
          <action android:name="com.eri.multiapp.action.UNFREEZE" />
          <action android:name="com.eri.multiapp.action.LAUNCH" />
          <action android:name="com.eri.multiapp.action.DESTROY" />
          <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
      </activity>

      <!-- Target of home-screen shortcuts. NOT exported: launchers start pinned
           shortcuts on our behalf, other apps cannot reach it. -->
      <activity
        android:name=".space.CloneLauncherActivity"
        android:theme="@style/Transparent"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:noHistory="true"
        android:exported="false" />
    </application>
</manifest>
